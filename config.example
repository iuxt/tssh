# tssh example configuration
#
# This file demonstrates the SSH-style configuration loaded by tssh.
#
# Files loaded automatically:
#   ~/.tssh/config
#   ~/.tssh/password
# Use `tssh -F /path/to/config` to select a different host configuration file.
# Global settings files ($XDG_CONFIG_HOME/tssh/tssh.conf,
# ~/.config/tssh/tssh.conf, and ~/.tssh.conf) are not loaded.
#
# Recommended layout:
#   - Put normal OpenSSH-compatible options in ~/.tssh/config, or in the file
#     selected with `tssh -F`. ~/.ssh/config is not loaded automatically.
#   - Put tssh-specific options and secrets in ~/.tssh/password.
#   - Write configuration directives directly as `Key Value`. For a secret
#     containing `#`, use `Key=Value`; see the password example below.
#
# -----------------------------------------------------------------------------
# Basic hosts
# -----------------------------------------------------------------------------

Host prod-web-01
    HostName 10.0.10.11
    User deploy
    Port 22
    GroupLabels prod web

Host prod-db-01
    HostName 10.0.20.21
    User dba
    Port 22
    GroupLabels prod db
    # Hide from the tssh prompt, but still allow `tssh prod-db-01`.
    HideHost yes

Host dev-box
    HostName dev.example.com
    User dev
    Port 2222
    GroupLabels dev
    RemoteCommand tmux new -A -s dev
    RequestTTY yes


# -----------------------------------------------------------------------------
# Wildcards and grouped hosts
# -----------------------------------------------------------------------------

Host lab-*
    User lab
    Port 22
    GroupLabels lab test
    IdentityFile ~/.ssh/lab_ed25519

Host lab-build-01
    HostName 192.168.56.21
    GroupLabels build

Host lab-build-02
    HostName 192.168.56.22
    GroupLabels build


# -----------------------------------------------------------------------------
# Jump hosts and proxy commands
# -----------------------------------------------------------------------------

Host bastion
    HostName bastion.example.com
    User jump
    Port 22
    GroupLabels gateway

Host internal-web
    HostName 10.10.1.20
    User deploy
    ProxyJump bastion
    GroupLabels internal web

Host internal-db
    HostName 10.10.2.30
    User postgres
    ProxyCommand ssh bastion nc %h %p
    GroupLabels internal db

Host socks-proxy-target
    HostName target.internal
    ProxyCommand nc -x 127.0.0.1:1080 %h %p
    GroupLabels proxy


# -----------------------------------------------------------------------------
# ControlMaster multiplexing
# -----------------------------------------------------------------------------
#
# ControlMaster speeds up repeated connections. If password prompts are handled
# by the underlying OpenSSH control master, use CtrlExpect* options below when
# automation is needed.

Host mux-*
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 10m

Host mux-web
    HostName web.example.com
    User deploy


# -----------------------------------------------------------------------------
# Port forwarding
# -----------------------------------------------------------------------------

Host tunnel-web
    HostName web.internal
    ProxyJump bastion
    LocalForward 127.0.0.1:8080 127.0.0.1:80
    LocalForward 127.0.0.1:8443 127.0.0.1:443
    ClearAllForwardings no
    ExitOnForwardFailure yes

Host tunnel-db
    HostName db.internal
    ProxyJump bastion
    LocalForward 127.0.0.1:5432 127.0.0.1:5432
    StreamLocalBindUnlink yes

Host tunnel-remote
    HostName public.example.com
    RemoteForward 127.0.0.1:9000 127.0.0.1:9000
    GatewayPorts no

Host tunnel-socks
    HostName bastion.example.com
    DynamicForward 127.0.0.1:1080


# -----------------------------------------------------------------------------
# X11, Wayland, and clipboard integration
# -----------------------------------------------------------------------------

Host x11-host
    HostName workstation.example.com
    ForwardX11 yes
    ForwardX11Trusted no
    ForwardX11Timeout 20m
    XAuthLocation /usr/bin/xauth

Host wayland-host
    HostName wayland.example.com
    EnableWaypipe yes
    WaypipeClientPath /usr/bin/waypipe
    WaypipeServerPath /usr/bin/waypipe
    WaypipeClientOption -c lz4
    WaypipeServerOption -c lz4

Host clipboard-host
    HostName clip.example.com
    EnableOSC52 yes


# -----------------------------------------------------------------------------
# DNS SRV and canonicalization
# -----------------------------------------------------------------------------

Host home
    DnsSrvName home.example.com
    User pi
    GroupLabels home

Host *.corp
    CanonicalizeHostname yes
    CanonicalDomains corp.example.com internal.example.com
    CanonicalizeMaxDots 1
    CanonicalizeFallbackLocal yes


# -----------------------------------------------------------------------------
# Ciphers and legacy servers
# -----------------------------------------------------------------------------

Host legacy-server
    HostName legacy.example.com
    User admin
    # Prefixes supported by tssh:
    #   +cipher  append cipher
    #   -pattern remove matching ciphers
    #   ^cipher  prepend cipher
    #   list     replace cipher list
    Ciphers +aes128-cbc
    HostKeyAlgorithms +ssh-rsa
    PubkeyAcceptedAlgorithms +ssh-rsa


# -----------------------------------------------------------------------------
# Kerberos / GSSAPI
# -----------------------------------------------------------------------------

Host kerberos-host
    HostName krb.example.com
    User krbuser
    GSSAPIAuthentication yes


# -----------------------------------------------------------------------------
# Local commands and environment
# -----------------------------------------------------------------------------

Host with-env
    HostName env.example.com
    SendEnv LANG LC_*
    SetEnv TERM=xterm-256color APP_ENV=dev

Host with-local-command
    HostName app.example.com
    PermitLocalCommand yes
    LocalCommand echo connected to %n at %h:%p


# -----------------------------------------------------------------------------
# Secrets in ~/.tssh/password
# -----------------------------------------------------------------------------
#
# Put the examples in this section in ~/.tssh/password to keep secrets separate
# from the main host configuration. OpenSSH does not recognize these secret
# options, so do not put them in ~/.ssh/config.
#
# Prefer a password manager command below when possible. Plain text values
# should only be kept in a file with restrictive permissions.

Host password-plain
    HostName password.example.com
    User demo
    Password change-me

# In the `Key Value` form, `#` starts a comment. Use `Key=Value` when the
# password contains a literal `#`; characters such as `\`, `;`, `'`, and `#`
# are then preserved as part of the password.
Host password-with-special-characters
    HostName password.example.com
    User demo
    Password=example\_52;with@'#symbols

# Run `tssh --enc-secret` and enter any password (including special characters)
# to generate an encPassword value. The value below decodes to the same example
# password above. This is obfuscation with a key embedded in tssh, not secure
# storage.
Host password-encrypted
    HostName password.example.com
    User demo
    encPassword 50431eb14e84bac5ca60885455034e6869e1235ea71d32a5cf067804ffc5039cc6aae926eb784a492c9ddef92ab8e68a638fe32dd7cf

Host password-configured
    HostName password.example.com
    User demo
    Password change-me

Host key-with-passphrase
    HostName key.example.com
    User demo
    IdentityFile ~/.ssh/id_ed25519_encrypted
    Passphrase change-me

Host id_ed25519*
    # Match private-key filenames to provide a shared passphrase for that key.
    Passphrase change-me


# -----------------------------------------------------------------------------
# External password managers
# -----------------------------------------------------------------------------
#
# Any secret key can use a Command suffix. Tokens such as %n, %h, %p and %r are
# expanded before executing the command.

Host gopass-host
    PasswordCommand gopass show -o ssh/%n
    PassphraseCommand gopass show -o ssh/%n/passphrase

Host pass-host
    PasswordCommand pass show ssh/%n

Host onepassword-host
    PasswordCommand op read "op://Private/ssh-%n/password"

Host macos-keychain-host
    PasswordCommand security find-generic-password -a %r -s %n -w

Host bitwarden-host
    PasswordCommand bw get password ssh-%n

Host vault-host
    PasswordCommand vault kv get -field=password secret/ssh/%n


# -----------------------------------------------------------------------------
# Keyboard-interactive answers, TOTP, and OTP commands
# -----------------------------------------------------------------------------

Host question-fixed
    HostName kbd.example.com
    KbdInteractiveAuthentication yes
    # For fixed questions, use QuestionAnswer followed by the question number.
    QuestionAnswer1 yes
    QuestionAnswer2 no

Host question-by-text
    HostName kbd.example.com
    # The question "code: " is hex encoded as 636f64653a20.
    totp636f64653a20 JBSWY3DPEHPK3PXP
    otp746f6b656e3a20 oathtool --totp -b JBSWY3DPEHPK3PXP

Host totp-numbered
    HostName totp.example.com
    TotpSecret1 JBSWY3DPEHPK3PXP
    TotpSecret2 JBSWY3DPEHPK3PXP

Host otp-numbered
    HostName otp.example.com
    OtpCommand1 oathtool --totp -b JBSWY3DPEHPK3PXP
    OtpCommand2 oathtool --totp -b JBSWY3DPEHPK3PXP


# -----------------------------------------------------------------------------
# Automated interaction
# -----------------------------------------------------------------------------
#
# Use Expect* options to respond to prompts after the remote shell or command
# starts. Use CtrlExpect* options to handle prompts from the underlying OpenSSH
# process when establishing a control-master connection.
#
# Pattern values use wildcard matching: `*` matches any text and `?` matches
# one character. SendText values need `\r` when you want to send Enter.

Host expect-password
    HostName expect.example.com
    ExpectCount 2
    ExpectTimeout 30
    ExpectPattern1 *assword
    ExpectSendText1 change-me\r
    ExpectPattern2 hostname*$
    ExpectSendText2 echo connected\r

Host expect-case
    HostName expect-case.example.com
    ExpectCount 1
    ExpectPattern1 hostname*$
    ExpectCaseSendText1 yes/no y\r
    ExpectCaseSendText1 y/n yes\r
    ExpectSendText1 ssh next-hop\r

Host expect-totp
    HostName expect-totp.example.com
    ExpectCount 1
    ExpectPattern1 token:
    ExpectSendTotp1 JBSWY3DPEHPK3PXP

Host expect-otp
    HostName expect-otp.example.com
    ExpectCount 1
    ExpectPattern1 token:
    ExpectSendOtp1 oathtool --totp -b JBSWY3DPEHPK3PXP

Host expect-slow
    HostName slow.example.com
    ExpectCount 2
    ExpectSleepMS 100
    ExpectPattern1 x>
    ExpectSendText1 1\|\r
    ExpectPattern2 y>
    ExpectSendText2 \|1\|\|\r
    # For TOTP and OTP senders, choose: no, each, or enter.
    ExpectPassSleep enter

Host ctrl-expect
    HostName ctrl.example.com
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 10m
    CtrlExpectCount 1
    CtrlExpectPattern1 *assword
    CtrlExpectSendText1 change-me\r


# -----------------------------------------------------------------------------
# Minimal practical template
# -----------------------------------------------------------------------------
#
# Copy this block and edit HostName/User/GroupLabels/IdentityFile as needed.

Host my-server
    HostName 203.0.113.10
    User myuser
    Port 22
    IdentityFile ~/.ssh/id_ed25519
    GroupLabels personal
    EnableOSC52 yes


# -----------------------------------------------------------------------------
# Base defaults (keep this block after the specific Host blocks)
# -----------------------------------------------------------------------------
#
# SSH configuration uses the first matching value for each single-value option.
# Put specific hosts first so their User, Port, and other settings take priority.
# IdentityFile is cumulative: matching blocks can add multiple identity files.

Host *
    User iuxt
    Port 22
    ServerAliveInterval 30
    ServerAliveCountMax 3
    ConnectTimeout 10
    LogLevel ERROR
    AddressFamily any

    # Public-key authentication.
    PubkeyAuthentication yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519

    # Agent forwarding. Enable only for hosts you trust.
    ForwardAgent no
    IdentityAgent $SSH_AUTH_SOCK

    # Host key checking.
    StrictHostKeyChecking ask
    UserKnownHostsFile ~/.ssh/known_hosts

    # 启用 trz/tsz 文件传输（默认开启）。服务器需安装 trzsz，本地无需额外安装。
    # 登录服务器后，执行 trz 上传文件，执行 tsz <文件路径> 下载文件。
    EnableTrzsz yes

    # 启用 rz/sz 文件传输（默认开启）。服务器和本地均需安装 lrzsz。
    # 登录服务器后，执行 rz 上传文件，执行 sz <文件路径> 下载文件。
    EnableZmodem yes

    # 启用拖拽上传（默认关闭）。开启后，将本地文件拖入终端即可上传。
    EnableDragFile yes

    # 指定拖拽上传时在服务器上执行的命令，默认为 rz。
    # 此处使用 trz，需启用 EnableTrzsz；拖入目录时会自动执行 trz -d。
    # 如需使用 rz，请将此项设为 rz，并启用 EnableZmodem。
    DragFileUploadCommand trz

    # 使用 trz/rz 上传时，文件选择框默认打开的本地目录。
    DefaultUploadPath ~/Downloads

    # 使用 tsz/sz 下载时，文件会自动保存到此本地目录，请确保目录已存在。
    # 不设置此项时，每次下载都会弹出目录选择框。
    DefaultDownloadPath ~/Downloads

    # 设置 trz/tsz 进度条的渐变颜色，填写两个以空格分隔的六位十六进制颜色值。
    # 例如下方的 B14FFF 和 00FFA3，颜色值前不加 #。
    ProgressColorPair B14FFF 00FFA3

    # Allow remote applications to copy text into the local clipboard via OSC52.
    EnableOSC52 yes

    # Console escape. Set ConsoleEscapeTime to 0 to disable tssh console escape.
    EscapeChar ~
    ConsoleEscapeTime 1
